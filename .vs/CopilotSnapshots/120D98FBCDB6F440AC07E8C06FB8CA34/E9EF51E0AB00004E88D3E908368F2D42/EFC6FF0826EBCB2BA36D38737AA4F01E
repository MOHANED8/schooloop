#include "Student.h"
#include <iostream>
using namespace std;

Student::Student() : studentId(""), name(""), grade(0.0f)
{
}

Student::Student(string id, string studentName, float studentGrade)
	: studentId(id), name(studentName), grade(0.0f)
{
	setGrade(studentGrade);
}

void Student::setStudentId(string id)
{
	studentId = id;
}

void Student::setName(string n)
{
	name = n;
}

void Student::setGrade(float g)
{
	if (g < 0.0f)
	{
		grade = 0.0f;
	}
	else if (g > 100.0f)
	{
		grade = 100.0f;
	}
	else
	{
		grade = g;
	}
}

void Student::displayInfo() const
{
	cout << "Student ID: " << studentId << endl;
	cout << "Name: " << name << endl;
	cout << "Grade: " << grade << endl;
}

void Student::increaseGrade(Student* student, float amount)
{
	if (student != nullptr)
	{
		::increaseGrade(student, amount);
	}
}

string Student::getStudentId() const
{
	return studentId;
}

float Student::getGrade() const
{
	return grade;
}

string Student::getName() const
{
	return name;
}

void increaseGrade(Student* student, float amount)
{
	if (student == nullptr || amount < 0.0f)
	{
		return;
	}

	student->setGrade(student->getGrade() + amount);
}

Student* findHighestGrade(Student* students, int size)
{
	if (students == nullptr || size <= 0)
	{
		return nullptr;
	}

	Student* highest = students;
	for (int i = 1; i < size; ++i)
	{
		if ((students + i)->getGrade() > highest->getGrade())
		{
			highest = students + i;
		}
	}

	return highest;
}